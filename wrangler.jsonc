{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cbrief",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  // Deploy the Vite-built SSR worker (virtual imports already resolved), not
  // src/server.ts — wrangler cannot resolve TanStack's #tanstack-* virtual
  // imports when it re-bundles source. `dist` is built in CI before deploy.
  "main": "dist/server/server.js",
  "assets": {
    "directory": "dist/client"
  }
}
